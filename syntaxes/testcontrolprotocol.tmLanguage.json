{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Test Control Protocol",
	"patterns": [
		{
			"include": "#invalid"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#title-lines"
		},
		{
			"include": "#macro-definition-lines"
		},
		{
			"include": "#global-header-lines"
		},
		{
			"include": "#hex-lines"
		},
		{
			"include": "#number-lines"
		},
		{
			"include": "#alpha-lines"
		},
		{
			"include": "#goto-lines"
		},
		{
			"include": "#goto-ir-lines"
		},
		{
			"include": "#search-lines"
		},
		{
			"include": "#gotcp-lines"
		},
		{
			"include": "#simple-branch-lines"
		},
		{
			"include": "#normalx-lines"
		},
		{
			"include": "#data-reference-lines"
		},
		{
			"include": "#cr-report-lines"
		},
		{
			"include": "#print-data-reference-lines"
		},
		{
			"include": "#op2-data-reference-lines"
		},
		{
			"include": "#instruction-lines"
		}
	],
	"repository": {
		"invalid": {
			"patterns": [
				{
					"name": "invalid.too-long.testcontrolprotocol",
					"match": "^.{81}.*\n"
				},
				{
					"name": "invalid.illegal-character.testcontrolprotocol",
					"match": "^.{6}[^\\s].*\n"
				}
			]
		},
		"comments": {
			"patterns": [{
				"name": "comment.line.testcontrolprotocol",
				"match": "^.{7}\\K\\*.*\n"
			}]
		},
		"title-lines": {
			"captures": {
				"2": {
					"name": "support.type.testcontrolprotocol"
				},
				"3": {
					"name": "support.type.testcontrolprotocol"
				},
				"4": {
					"name": "string.testcontrolprotocol"
				},
				"5": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})([TQ]\\d{4})(.{1,17})?(.{1,62})?(.*)",
			"name": "title-line.testcontrolprotocol"
		},
		"macro-definition-lines": {
			"captures": {
				"2": {
					"name": "support.type.testcontrolprotocol"
				},
				"3": {
					"name": "support.type.testcontrolprotocol"
				},
				"4": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bD\\b\\s)([^ ]{1,8})?\\s*(.*)",
			"name": "macro-definition-line.testcontrolprotocol"
		},
		"global-header-lines": {
			"captures": {
				"2": {
					"name": "support.type.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(GLOBAL\\s+ALPHA\\s+DATA.*)",
			"name": "global-header-line.testcontrolprotocol"
		},
		"hex-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "storage.testcontrolprotocol"
				},
				"4": {
					"name": "string.control.testcontrolprotocol"
				},
				"5": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bH\\b\\s)(.{1,8}\\s)?(.{1,61})(.*)",
			"name": "hex-line.testcontrolprotocol"
		},
		"number-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "storage.testcontrolprotocol"
				},
				"4": {
					"name": "string.testcontrolprotocol"
				},
				"5": {
					"name": "string.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\b[NRS]\\b\\s)(.{1,8}\\s)(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8}\\s)?(.*)",
			"name": "number-line.testcontrolprotocol"
		},
		"alpha-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "storage.testcontrolprotocol"
				},
				"4": {
					"name": "string.testcontrolprotocol"
				},
				"5": {
					"name": "invalid.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\b[AM]\\b\\s)(.{1,8}\\s)(.{1,61})(.*)",
			"name": "alpha-line.testcontrolprotocol"
		},
		"goto-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\b(?:GOTO(?:,(?:EQ|NE|GT|GE|LT|LE|OR|MM|M))?|GOSUB(?:,(?:EQ|NE|GT|GE|LT|LE|OR|MM|M))?|DATE,(?:EQ|NE|GT|GE|LT|LE)|GET(?:,[EOA])?)\\s+)(.{1,9}\\s)?(.{1,8}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"goto-ir-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "storage.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\b(?:GOTO|GOSUB),IR\\b\\s{1,4})(.{1,9}\\s)?(.{1,9}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"search-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "invalid.testcontrolprotocol"
				},
				"8": {
					"name": "string.testcontrolprotocol"
				},
				"9": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\bSEARCH\\s+)(.{1,9}\\s)?(?:(\\b(?:PATIENT|DATETIME|ARRSET|REPORTED|TRACKED|TESTDEPT|REQUEST|CONSTIT|ANTIBODY|PRODUCT|GROUP|TEST|NAME)\\b\\s*)|(\\S.{0,8}\\s*))?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"gotcp-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "support.type.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\bGOTCP(?:,(?:EQ|NE|GT|GE|LT|LE))?\\s+)(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"simple-branch-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"6": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\b(?:REQPRIOR|OPENFILE|COPYDR|CRDX|REQUEST|REQNEXT|GETSPEC)\\b\\s{1,5})(.{1,9}\\s)?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"normalx-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "support.type.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "invalid.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\bNORMALX\\b\\s{1,4})(.{1,9}\\s)?(?:(\\b(?:DATE REG|DATE ARR|DATE COL|DATESPEC|ENTDATE|AUTHDATE)\\b\\s*)|(\\S.{0,8}\\s*))?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"data-reference-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "storage.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)((?:\\b(?:NORMAL|GROUP|CR COM|MOVE,AV|MOVE,AP|TESTADD|HL7SET|ALPHA|CHARGE|REPTKEY)\\b|\\bCHECK\\*)\\s{1,4})(.{1,9}\\s)?(.{1,8}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"cr-report-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "storage.testcontrolprotocol"
				},
				"6": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"7": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\b(?:CR TEST|CR CRS|CR REQ|CR REQL)\\b\\s{1,4})(.{1,9}\\s)?(.{1,9}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"print-data-reference-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "string.testcontrolprotocol"
				},
				"6": {
					"name": "storage.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\bPRINT(?:,[HA])?\\b\\s{1,4})(.{1,9}\\s)?(.{1,9}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"op2-data-reference-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "string.testcontrolprotocol"
				},
				"6": {
					"name": "storage.testcontrolprotocol"
				},
				"7": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)(\\b(?:TESTRES|STATS|NUMERIC)\\b\\s{1,4})(.{1,9}\\s)?(.{1,9}\\s)?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		},
		"instruction-lines": {
			"captures": {
				"2": {
					"name": "entity.other.attribute-name.testcontrolprotocol"
				},
				"3": {
					"name": "entity.name.function.testcontrolprotocol"
				},
				"4": {
					"name": "keyword.control.testcontrolprotocol"
				},
				"5": {
					"name": "string.testcontrolprotocol"
				},
				"6": {
					"name": "string.testcontrolprotocol"
				},
				"7": {
					"name": "string.testcontrolprotocol"
				},
				"8": {
					"name": "comment.line.testcontrolprotocol"
				}
			},
			"match": "(^.{7})(\\bI\\b\\s)(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8}\\s)?(.{1,8})?(.*)",
			"name": "instruction-line.testcontrolprotocol"
		}
	},
	"scopeName": "source.testcontrolprotocol"
}