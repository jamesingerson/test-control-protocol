       I          GOSUB    SUB1
       I          SEARCH   NOTFND   TEST     FIRST
       I          DATE,GT  TODAY    FMT
       I          GOTCP    T0400    START
       I          GOTCP,EQ T0500    FLAG
       I          GET      RESULT   PCT1
       I          GOTO,MM  PCT1     TEMPLATE
       I          GOTO,XX  PCT1     VALUE
       I          NORMAL   RRANGE
       I          CR TEST  TESTA    TESTB    RESA-C
       I          CR CRS   CRSA-P
       I          CR CRS   CRSB-P            CRSB-C
       I          GROUP    TITLE
       I NEXT     GROUP
       I          CR REQ   REQA-P   REQA-H   REQA-L
       I HBACOMS  CR COM   HBAC-P
       I          CR COM
       I          PRINT    1        TITLE
       I          PRINT,H  1        DATE8
       I          PRINT,A  50       SPACE    5
       I          PRINT,R  21
       I          PRINT,J  31       AV0
       I          GOTO,IR  SCHECK   VALUE    SIGNIF
       I          GOTO,IR  FIN      VALUE    RANGE
       I TPX      NORMALX  0710
       I          NORMALX  0770     DATE REG
       I          NORMALX
