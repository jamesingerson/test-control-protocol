       I          GOSUB    SUB1
       I          SEARCH   NOTFND   TEST     FIRST
       I          DATE,GT  TODAY    FMT
       I          GOTCP    T0400    START
       I          GOTCP,EQ T0500    FLAG
       I          GET      RESULT   PCT1
       I          GOTO,MM  PCT1     TEMPLATE
       I          GOTO,XX  PCT1     VALUE
       I          NORMAL   RRANGE
       I          CR TEST  TESTA    TESTB    RESA-C
       I          CR CRS   CRSA-P
       I          GROUP    TITLE
       I NEXT     GROUP
